{
  "name": "visual-learner",
  "version": "0.1.0",
  "description": "Interactive visual learning from PDFs — powered by AI",
  "private": true,
  "workspaces": [
    "frontend",
    "electron"
  ],
  "scripts": {
    "dev": "node scripts/start-dev.mjs",
    "dev:vite": "cd frontend \u0026\u0026 npx vite",
    "dev:electron": "cd electron \u0026\u0026 npx vite -c ../electron.vite.config.ts",
    "build": "npm run build:frontend \u0026\u0026 npm run build:electron",
    "build:frontend": "cd frontend \u0026\u0026 npx vite build",
    "build:electron": "node scripts/build-electron.mjs \u0026\u0026 npx electron-builder",
    "build:backend": "cd backend \u0026\u0026 pyinstaller main.py --name visual-learner-backend --distpath dist",
    "test": "npm run test:frontend \u0026\u0026 npm run test:backend",
    "test:frontend": "cd frontend \u0026\u0026 vitest run",
    "test:backend": "cd backend \u0026\u0026 pytest",
    "test:coverage": "cd frontend \u0026\u0026 vitest run --coverage \u0026\u0026 cd ../backend \u0026\u0026 pytest --cov",
    "lint": "npm run lint:frontend \u0026\u0026 npm run lint:backend",
    "lint:frontend": "cd frontend \u0026\u0026 npm run lint",
    "lint:backend": "cd backend \u0026\u0026 npx black --check . \u0026\u0026 npx isort --check . \u0026\u0026 npx mypy app/",
    "lint:fix": "cd frontend \u0026\u0026 npm run lint:fix",
    "format": "npm run format:frontend \u0026\u0026 npm run format:backend",
    "format:frontend": "cd frontend \u0026\u0026 npm run format:fix",
    "format:backend": "cd backend \u0026\u0026 npx black . \u0026\u0026 npx isort .",
    "type-check": "cd frontend \u0026\u0026 npx vue-tsc --noEmit",
    "clean": "rm -rf frontend/dist dist-electron backend/dist",
    "clean:all": "rm -rf node_modules frontend/node_modules backend/__pycache__ dist-electron frontend/dist backend/dist",
    "install:all": "npm install \u0026\u0026 cd backend \u0026\u0026 pip install -r requirements.txt"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "7.7.0",
    "@typescript-eslint/parser": "7.7.0",
    "@vitejs/plugin-vue": "5.0.4",
    "@vitest/coverage-v8": "1.5.0",
    "@vitest/ui": "1.5.0",
    "@vue/test-utils": "2.4.5",
    "@vue/tsconfig": "0.5.1",
    "autoprefixer": "10.4.19",
    "concurrently": "8.2.2",
    "cross-env": "7.0.3",
    "electron": "29.3.0",
    "electron-builder": "24.13.3",
    "eslint": "8.57.0",
    "eslint-import-resolver-typescript": "3.6.1",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "eslint-plugin-vue": "9.24.0",
    "happy-dom": "14.7.1",
    "postcss": "8.4.38",
    "prettier": "3.2.5",
    "prettier-plugin-tailwindcss": "0.5.14",
    "rimraf": "5.0.5",
    "tailwindcss": "3.4.3",
    "typescript": "5.4.5",
    "vite": "5.2.8",
    "vite-plugin-electron": "0.28.4",
    "vite-plugin-electron-renderer": "0.14.5",
    "vitest": "1.5.0",
    "vue-tsc": "1.8.27"
  },
  "engines": {
    "node": "\u003e=20.0.0",
    "npm": "\u003e=10.0.0"
  }
}
