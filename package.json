{
  "name": "visual-learner",
  "version": "0.1.0",
  "description": "Interactive visual learning from PDFs — standalone desktop app",
  "private": true,
  "main": "frontend/dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "cd frontend && vite",
    "build": "cd frontend && vue-tsc --noEmit && vite build",
    "build:backend": "cd backend && pyinstaller build.spec --clean --noconfirm",
    "build:app": "cd frontend && vite build && cd .. && electron-builder",
    "dist": "npm run build:backend && npm run build:app",
    "lint": "eslint frontend/src --ext .ts,.vue",
    "test": "cd backend && pytest -v"
  },
  "build": {
    "appId": "com.jl115.visual-learner",
    "productName": "Visual Learner",
    "directories": {
      "output": "release",
      "buildResources": "frontend/dist"
    },
    "files": [
      "frontend/dist",
      "frontend/dist-electron",
      {
        "from": "backend/dist",
        "to": "backend",
        "filter": ["**/*"]
      }
    ],
    "extraResources": [
      {
        "from": "backend/dist",
        "to": "backend",
        "filter": ["**/*"]
      }
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        }
      ],
      "notarize": false,
      "darkModeSupport": true
    },
    "asar": true,
    "asarUnpack": [
      "backend/**/*"
    ]
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "@vitejs/plugin-vue": "^5.0.0",
    "vite": "^5.0.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.5",
    "typescript": "^5.4.0",
    "vue-tsc": "^2.0.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint-plugin-vue": "^9.0.0"
  },
  "dependencies": {}
}
