# .env.example — copy to .env and fill in your values.
# NOTE: .env.example is a template and IS tracked in git.
#       .env (real secrets) is gitignored.

# ── Ollama ──────────────────────────────────────────────
OLLAMA_ENDPOINT=https://ollama.com/v1
OLLAMA_API_KEY=
OLLAMA_MODEL=llama3.1

# ── Database ────────────────────────────────────────────
DATABASE_URL=sqlite:///~/.visual-learner/data.sqlite

# ── App ─────────────────────────────────────────────────
LOG_LEVEL=INFO
APP_VERSION=0.1.0

# ── Frontend (Vite picks these up automatically) ─────────
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_VERSION=0.1.0

